<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Urras.App"
        x:Class="Urras.App.MainWindow"
        Title="Urras"
        Icon="/Assets/urras.ico"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="560">

  <Window.Styles>
    <!-- Names and commits in History open their page on the website when clicked -->
    <Style Selector=":is(Control).link">
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="TextBlock.link:pointerover">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
    <Style Selector="TextBlock.header">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,6,0,4" />
    </Style>
    <Style Selector="ListBox.files ListBoxItem">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <!-- History rows have no vertical padding so the graph's lines join from row to row -->
    <Style Selector="ListBox.history ListBoxItem">
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <!-- Urras's own minimise, maximise and close buttons on Windows, flat like Windows 11's -->
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="46" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.caption Path">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="Stroke" Value="{DynamicResource Urras.Text}" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Urras.Hover}" />
    </Style>
    <Style Selector="Button.caption:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Urras.Pressed}" />
    </Style>
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#C42B1C" />
    </Style>
    <Style Selector="Button.caption.close:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#B22A1B" />
    </Style>
    <Style Selector="Button.caption.close:pointerover Path">
      <Setter Property="Stroke" Value="White" />
    </Style>
    <Style Selector="Border.refBadge">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="Margin" Value="0,0,5,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="#33E8B931" />
      <Setter Property="BorderBrush" Value="#E8B931" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- Label text in theme colours: pale on dark themes, deep on light ones -->
    <Style Selector="Border.refBadge TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Urras.Warning}" />
    </Style>
    <Style Selector="Border.refBadge.head">
      <Setter Property="Background" Value="#E8B931" />
    </Style>
    <Style Selector="Border.refBadge.head TextBlock">
      <Setter Property="Foreground" Value="#1E1E1E" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.refBadge.remote">
      <Setter Property="Background" Value="#33539BF5" />
      <Setter Property="BorderBrush" Value="#539BF5" />
    </Style>
    <Style Selector="Border.refBadge.remote TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Urras.Attention}" />
    </Style>
    <Style Selector="Border.refBadge.tag">
      <Setter Property="Background" Value="#3357AB5A" />
      <Setter Property="BorderBrush" Value="#57AB5A" />
    </Style>
    <Style Selector="Border.refBadge.tag TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Urras.Added}" />
    </Style>
    <Style Selector="Border.refBadge.stash">
      <Setter Property="Background" Value="#33B083F0" />
      <Setter Property="BorderBrush" Value="#B083F0" />
    </Style>
    <!-- Branch badges take their commit's lane colour, so it's clear which line they belong to -->
    <Style Selector="Border.refBadge.lane">
      <Setter Property="BorderBrush" Value="{Binding Lane, Converter={x:Static local:GraphConverters.LaneBrush}}" />
      <Setter Property="Background" Value="{Binding Lane, Converter={x:Static local:GraphConverters.LaneTint}}" />
    </Style>
    <Style Selector="Border.refBadge.lane TextBlock">
      <Setter Property="Foreground" Value="{Binding Lane, Converter={x:Static local:GraphConverters.LaneBrush}}" />
    </Style>
    <Style Selector="Border.refBadge TextBlock.remoteName">
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="Border.refBadge.stash TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Urras.Accent}" />
    </Style>
    <Style Selector="Border.unpushed">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="8,1" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource Urras.Badge}" />
    </Style>
    <Style Selector="Border.unpushed TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Urras.Attention}" />
    </Style>
    <Style Selector="Border.unpushed TextBlock.narrow">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBox.narrow Border.unpushed TextBlock.narrow">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="ListBox.narrow Border.unpushed TextBlock.wide">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBox.diff ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <!-- Diff text: trimmed by default, scrolled sideways (unified view) or wrapped by the diff settings -->
    <Style Selector="TextBlock.code">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="ListBox.scroll TextBlock.code">
      <Setter Property="TextTrimming" Value="None" />
    </Style>
    <Style Selector="ListBox.wrap TextBlock.code">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextTrimming" Value="None" />
    </Style>
    <Style Selector="TextBlock.lineNumber">
      <Setter Property="Foreground" Value="{DynamicResource Urras.MutedText}" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,DejaVu Sans Mono,Liberation Mono,monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.columnHeader">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="TabControl#MainTabs > TabItem">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,2" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Opacity" Value="0.5" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="12" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
  </Window.Styles>

  <Window.Resources>
    <!-- Diff row templates; MainWindow picks one by the diff view setting -->
    <DataTemplate x:Key="RawDiffTemplate">
      <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" Classes="mono" Margin="6,0" />
    </DataTemplate>

    <DataTemplate x:Key="UnifiedDiffTemplate">
      <Grid ColumnDefinitions="52,52,20,*" Background="{Binding Background}">
        <TextBlock Grid.Column="0" Text="{Binding OldNumber}" Classes="mono lineNumber" />
        <TextBlock Grid.Column="1" Text="{Binding NewNumber}" Classes="mono lineNumber" />
        <TextBlock Grid.Column="2" Text="{Binding Marker}" Foreground="{Binding MarkerForeground}" Classes="mono" />
        <local:SegmentedTextBlock Grid.Column="3" Segments="{Binding Segments}" Foreground="{Binding Foreground}"
                                  Classes="mono code" />
        <TextBlock Grid.Column="0" Grid.ColumnSpan="4" Text="{Binding FullText}" Foreground="{Binding Foreground}"
                   FontWeight="{Binding Weight}" Classes="mono" Margin="8,0" TextTrimming="CharacterEllipsis" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SplitDiffTemplate">
      <Grid ColumnDefinitions="52,*,52,*" Background="{Binding Background}">
        <Border Grid.Column="0" Grid.ColumnSpan="2" Background="{Binding LeftBackground}" />
        <Border Grid.Column="2" Grid.ColumnSpan="2" Background="{Binding RightBackground}"
                BorderBrush="{DynamicResource Urras.Divider}" BorderThickness="1,0,0,0" />
        <TextBlock Grid.Column="0" Text="{Binding OldNumber}" Classes="mono lineNumber" />
        <local:SegmentedTextBlock Grid.Column="1" Segments="{Binding LeftSegments}" Foreground="{Binding Foreground}"
                                  Classes="mono code" Margin="0,0,6,0" />
        <TextBlock Grid.Column="2" Text="{Binding NewNumber}" Classes="mono lineNumber" />
        <local:SegmentedTextBlock Grid.Column="3" Segments="{Binding RightSegments}" Foreground="{Binding Foreground}"
                                  Classes="mono code" Margin="0,0,6,0" />
        <TextBlock Grid.Column="0" Grid.ColumnSpan="4" Text="{Binding FullText}" Foreground="{Binding Foreground}"
                   FontWeight="{Binding Weight}" Classes="mono" Margin="8,0" TextTrimming="CharacterEllipsis" />
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <DockPanel x:Name="RootPanel">

    <!-- Urras's own title bar on Windows (menus, title, and minimise, maximise and close), a menu row elsewhere;
         the empty parts drag the window. The shortcuts are handled in OnPreviewKeyDown -->
    <Grid x:Name="TitleBar" DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" MinHeight="32"
          Background="Transparent">
      <Image x:Name="TitleIcon" Grid.Column="0" Source="/Assets/urras.png" Width="16" Height="16"
             Margin="12,0,4,0" VerticalAlignment="Center" IsHitTestVisible="False" IsVisible="False" />
      <TextBlock x:Name="WindowTitle" Grid.Column="2" Classes="windowTitle" Text="Urras" IsVisible="False"
                 HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
      <Button x:Name="UpdateButton" Grid.Column="3" Classes="accent" Padding="10,3" Margin="0,0,6,0"
              VerticalAlignment="Center" IsVisible="False" />
      <Button x:Name="NotificationsButton" Grid.Column="4" Content="Notifications" Classes="subtle"
              Padding="10,4" VerticalAlignment="Center" IsVisible="False" />
      <StackPanel x:Name="CaptionButtons" Grid.Column="5" Orientation="Horizontal" Margin="8,0,0,0"
                  IsVisible="False">
        <Button x:Name="MinimiseButton" Classes="caption" ToolTip.Tip="Minimise">
          <Path Data="M0,5.5 H10" />
        </Button>
        <Button x:Name="MaximiseButton" Classes="caption" ToolTip.Tip="Maximise">
          <Path x:Name="MaximiseGlyph" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" />
        </Button>
        <Button x:Name="CloseButton" Classes="caption close" ToolTip.Tip="Close">
          <Path Data="M0,0 L10,10 M10,0 L0,10" />
        </Button>
      </StackPanel>
      <Menu Grid.Column="1" VerticalAlignment="Center" Background="Transparent">
        <MenuItem Header="_File">
          <MenuItem x:Name="NewRepositoryItem" Header="New repository…" InputGesture="Ctrl+N" />
          <MenuItem x:Name="AddLocalRepositoryItem" Header="Add local repository…" InputGesture="Ctrl+O" />
          <MenuItem x:Name="CloneRepositoryItem" Header="Clone repository…" InputGesture="Ctrl+Shift+O" />
          <Separator />
          <MenuItem x:Name="OptionsItem" Header="Options…   Ctrl+," />
          <Separator />
          <MenuItem x:Name="ExitItem" Header="Exit" InputGesture="Alt+F4" />
        </MenuItem>
        <!-- Like Anarres: settings, accounts and the Git log live in the title bar, not the status bar -->
        <MenuItem Header="_View">
          <MenuItem x:Name="SettingsButton" Header="_Settings…" />
          <MenuItem x:Name="AccountsButton" Header="_Accounts…" />
          <Separator />
          <MenuItem x:Name="LogToggle" Header="_Git log" ToggleType="CheckBox" />
        </MenuItem>
        <MenuItem Header="_Help">
          <MenuItem x:Name="ShortcutsItem" Header="_Keyboard shortcuts" InputGesture="F1" />
          <MenuItem x:Name="UpdatesItem" Header="Check for _updates…" />
          <Separator />
          <MenuItem x:Name="AboutButton" Header="_About Urras" />
        </MenuItem>
      </Menu>
    </Grid>

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Padding="12,4,12,10">
      <!-- The right-hand buttons always get their full width; the left side is cut off rather than run under them -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
          <Button x:Name="ViewOnlineButton" Content="View online" IsVisible="False" Classes="subtle" />
          <!-- Like GitHub Desktop: one button for what's needed now, the rest in the menu beside it -->
          <StackPanel Orientation="Horizontal">
            <Button x:Name="SyncButton" AutomationProperties.Name="Fetch, pull or push"
                    MinWidth="220" MaxWidth="300" HorizontalContentAlignment="Stretch"
                    CornerRadius="8,0,0,8">
              <DockPanel>
                <!-- Runs while Git works, so a long push or pull doesn't look stuck -->
                <ProgressBar x:Name="SyncProgress" DockPanel.Dock="Bottom" IsIndeterminate="True" IsVisible="False"
                             Height="2" MinHeight="2" Margin="0,3,0,0" />
                <Border x:Name="SyncBadge" DockPanel.Dock="Right" IsVisible="False"
                        Background="{DynamicResource Urras.Badge}" CornerRadius="9" Padding="7,1"
                        Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock x:Name="SyncBadgeText" FontSize="11" FontWeight="SemiBold" />
                </Border>
                <Path x:Name="SyncIcon" DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,10,0"
                      RenderTransformOrigin="50%,50%"
                      VerticalAlignment="Center" Stroke="{Binding $parent[Button].Foreground}"
                      StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" />
                <StackPanel>
                  <TextBlock x:Name="SyncTitle" Text="Fetch origin" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock x:Name="SyncDetail" Text="Never fetched" FontSize="11" Opacity="0.7"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DockPanel>
            </Button>
            <Button x:Name="SyncMenuButton" AutomationProperties.Name="More fetch, pull and push actions"
                    Content="▾" VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                    CornerRadius="0,8,8,0" Margin="1,0,0,0" ToolTip.Tip="Fetch, pull or push" />
          </StackPanel>
          <Button x:Name="RefreshButton" Content="Refresh" ToolTip.Tip="Refresh (F5)" Classes="subtle" />
        </StackPanel>
        <DockPanel Grid.Column="0" ClipToBounds="True">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
          <!-- Fixed width, matching the repository panel, so the branch box doesn't move with the name -->
          <TextBlock x:Name="RepositoryTitle" Text="No repository" FontSize="16" FontWeight="SemiBold"
                     VerticalAlignment="Center" Width="286" TextTrimming="CharacterEllipsis" />
          <Button x:Name="WorktreeButton" AutomationProperties.Name="Current worktree"
                    MinWidth="170" MaxWidth="260" HorizontalContentAlignment="Stretch"
                  CornerRadius="8"
                  IsVisible="False" ToolTip.Tip="Switch to another worktree of this repository, or make one">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="▾" VerticalAlignment="Center" Margin="8,0,0,0" />
              <StackPanel>
                <TextBlock Text="Current worktree" FontSize="11" Opacity="0.7" />
                <TextBlock x:Name="WorktreeButtonText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DockPanel>
          </Button>
          <Button x:Name="BranchButton" AutomationProperties.Name="Current branch"
                    MinWidth="240" MaxWidth="320" HorizontalContentAlignment="Stretch"
                  CornerRadius="8"
                  ToolTip.Tip="Switch branch, see pull requests, or merge (Ctrl+B)">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="▾" VerticalAlignment="Center" Margin="8,0,0,0" />
              <StackPanel>
                <TextBlock x:Name="BranchCaption" Text="Current branch" FontSize="11" Opacity="0.7"
                           TextTrimming="CharacterEllipsis" />
                <DockPanel>
                  <TextBlock x:Name="BranchCounts" DockPanel.Dock="Right" FontSize="12" Opacity="0.8"
                             VerticalAlignment="Center" Margin="8,0,0,0" />
                  <TextBlock x:Name="BranchButtonText" Text="No branch" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </StackPanel>
            </DockPanel>
          </Button>
          <Button x:Name="BranchMenuButton" Content="Branch ▾" Classes="subtle"
                  ToolTip.Tip="New or delete branch, merge, rebase, tags, repository settings" />
          <Button x:Name="StashMenuButton" Content="Stash ▾" Classes="subtle"
                  ToolTip.Tip="Stash changes, or manage stashes" />
        </StackPanel>
        <!-- Pinned repositories and folders, one click away -->
        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                      Margin="12,0,12,0">
          <StackPanel x:Name="PinnedBar" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" />
        </ScrollViewer>
        </DockPanel>
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="12,2,12,4">
      <DockPanel>
        <TextBlock x:Name="AutoFetchText" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource Urras.MutedText}" Margin="0,0,12,0" />
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="Ready"
                   FontSize="12" />
      </DockPanel>
    </Border>

    <!-- Git command log -->
    <TextBox x:Name="LogBox" DockPanel.Dock="Bottom" Height="170" IsVisible="False" IsReadOnly="True"
             AcceptsReturn="True" TextWrapping="NoWrap" FontSize="12"
             FontFamily="Cascadia Mono,Consolas,DejaVu Sans Mono,Liberation Mono,monospace" />

    <Grid ColumnDefinitions="300,4,*">

      <!-- Repositories -->
      <DockPanel Grid.Column="0" Margin="12,0,6,0">
        <DockPanel DockPanel.Dock="Top">
          <ComboBox x:Name="GroupingBox" DockPanel.Dock="Right" Width="120"
                    ToolTip.Tip="How the list is grouped: by repository name (forks and clones inside), by folder,
by owner (like GitHub Desktop), or by hand">
            <ComboBoxItem>By name</ComboBoxItem>
            <ComboBoxItem>By folder</ComboBoxItem>
            <ComboBoxItem>By owner</ComboBoxItem>
            <ComboBoxItem>Manual</ComboBoxItem>
          </ComboBox>
          <TextBlock Classes="header" Text="Repositories" />
        </DockPanel>
        <TextBox x:Name="RepositorySearchBox" DockPanel.Dock="Top" Margin="0,6,0,4" Classes="clearButton"
                 Watermark="Search repositories (Ctrl+F)"
                 ToolTip.Tip="Shows the repositories whose name, folder or group contains every word typed.
Esc clears it" />
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <Button x:Name="AddRepositoryButton" Content="Add…" Margin="0,0,6,6" />
          <Button x:Name="CloneButton" Content="Clone…" Margin="0,0,6,6" />
          <Button x:Name="ImportButton" Content="Import ▾" Margin="0,0,6,6"
                  ToolTip.Tip="Add many repositories: from a folder, from GitHub Desktop, or cloned from GitHub" />
          <Button x:Name="NewGroupButton" Content="New group…" Margin="0,0,6,6" />
          <Button x:Name="RemoveRepositoryButton" Content="Remove" Margin="0,0,6,6"
                  ToolTip.Tip="Remove the selected repository from the list, or the selected group" />
        </WrapPanel>
        <Panel>
          <TreeView x:Name="RepositoryTree" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <TreeView.Styles>
              <Style Selector="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Children}">
                <local:TreeGuides>
                  <StackPanel Margin="0,2" Opacity="{Binding ItemOpacity}">
                    <TextBlock Text="{Binding Name}" FontWeight="{Binding NameWeight}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Foreground="{Binding DetailBrush}" FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </local:TreeGuides>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
          <TextBlock x:Name="RepositoryHint" Classes="hint"
                     Text="Add a repository with Add… or Clone… to get started" />
        </Panel>
      </DockPanel>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <!-- Changes and History on a rounded panel above the window background -->
      <Border Grid.Column="2" Classes="card" Margin="0,0,12,0">
      <DockPanel>
      <!-- Shown while a bisect is running, in every tab -->
      <Border x:Name="BisectBanner" DockPanel.Dock="Top" IsVisible="False"
              Background="{DynamicResource Urras.AccentFaint}" BorderBrush="{DynamicResource Urras.Accent}"
              BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="6,6,10,0">
        <DockPanel>
          <Button x:Name="BisectStopButton" DockPanel.Dock="Right" Content="Stop bisect" Margin="6,0,0,0" />
          <Button x:Name="BisectSkipButton" DockPanel.Dock="Right" Content="Skip" Margin="6,0,0,0"
                  ToolTip.Tip="Can't test this commit (for example it doesn't build); try another" />
          <Button x:Name="BisectBadButton" DockPanel.Dock="Right" Content="Bad" Margin="6,0,0,0"
                  ToolTip.Tip="The problem is here" />
          <Button x:Name="BisectGoodButton" DockPanel.Dock="Right" Content="Good"
                  ToolTip.Tip="The problem is not here yet" />
          <TextBlock x:Name="BisectText" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
      </Border>
      <!-- Shown instead of the tabs when the open repository's folder is gone, like GitHub Desktop -->
      <Border x:Name="MissingPanel" DockPanel.Dock="Top" IsVisible="False" Margin="40,60,40,0">
        <StackPanel Spacing="12" MaxWidth="600" HorizontalAlignment="Center">
          <TextBlock x:Name="MissingTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="MissingText" TextWrapping="Wrap" Opacity="0.8" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="LocateButton" Content="Locate…" Classes="accent"
                    ToolTip.Tip="Point Urras at where the repository is now" />
            <Button x:Name="CloneAgainButton" Content="Clone again"
                    ToolTip.Tip="Clone it again into the same folder" />
            <Button x:Name="RemoveMissingButton" Content="Remove" ToolTip.Tip="Take it off the list" />
          </StackPanel>
        </StackPanel>
      </Border>
      <TabControl x:Name="MainTabs" Margin="12,2,12,10">

        <TabItem Header="Changes">
          <DockPanel>
            <!-- Shown while a merge, rebase, cherry-pick or revert waits for conflicts to be resolved -->
            <Border x:Name="OperationBanner" DockPanel.Dock="Top" IsVisible="False"
                    Background="{DynamicResource Urras.WarningFaint}" BorderBrush="{DynamicResource Urras.Warning}"
                    BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,6,0,0">
              <DockPanel>
                <Button x:Name="AbortButton" DockPanel.Dock="Right" Content="Abort…" Margin="6,0,0,0" />
                <Button x:Name="ContinueButton" DockPanel.Dock="Right" Content="Continue" Classes="accent" />
                <TextBlock x:Name="OperationText" VerticalAlignment="Center" TextWrapping="Wrap" />
              </DockPanel>
            </Border>
            <Grid ColumnDefinitions="400,4,*">

              <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto,*,Auto" Margin="0,0,6,0">
                <DockPanel Grid.Row="0" Margin="0,6,0,0">
                  <CheckBox x:Name="HideUntrackedBox" DockPanel.Dock="Right" Content="Hide untracked" Margin="8,0,0,0"
                            ToolTip.Tip="Hide untracked files; Stage all then stages tracked files only" />
                  <TextBox x:Name="FileFilterBox" Watermark="Filter files" Classes="clearButton" />
                </DockPanel>
                <DockPanel Grid.Row="1">
                  <Button x:Name="StageAllButton" DockPanel.Dock="Right" Content="Stage all" Padding="8,2" />
                  <TextBlock x:Name="UnstagedHeader" Classes="header" Text="Changes" />
                </DockPanel>
                <Panel Grid.Row="2">
                  <ListBox x:Name="UnstagedList" Classes="files" SelectionMode="Multiple">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <local:ChangeKindBadge Change="{Binding}" />
                          <TextBlock Text="!" FontWeight="Bold" Foreground="{DynamicResource Urras.Warning}"
                                     IsVisible="{Binding HasWarning}" ToolTip.Tip="{Binding Warning}" />
                          <TextBlock Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock x:Name="UnstagedHint" Classes="hint" Text="No changes" />
                </Panel>

                <DockPanel Grid.Row="3" Margin="0,6,0,0">
                  <Button x:Name="UnstageAllButton" DockPanel.Dock="Right" Content="Unstage all" Padding="8,2" />
                  <TextBlock x:Name="StagedHeader" Classes="header" Text="Staged" />
                </DockPanel>
                <Panel Grid.Row="4">
                  <ListBox x:Name="StagedList" Classes="files" SelectionMode="Multiple">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <local:ChangeKindBadge Change="{Binding}" />
                          <TextBlock Text="!" FontWeight="Bold" Foreground="{DynamicResource Urras.Warning}"
                                     IsVisible="{Binding HasWarning}" ToolTip.Tip="{Binding Warning}" />
                          <TextBlock Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock x:Name="StagedHint" Classes="hint"
                             Text="Nothing staged. Double-click a change to stage it." />
                </Panel>

                <StackPanel Grid.Row="5" Spacing="6" Margin="0,8,0,4">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Name="StageSelectedButton" Content="Stage"
                            ToolTip.Tip="Stage selected (or double-click)" />
                    <Button x:Name="UnstageSelectedButton" Content="Unstage" ToolTip.Tip="Unstage selected" />
                    <Button x:Name="DiscardButton" Content="Discard…" ToolTip.Tip="Discard selected changes" />
                  </StackPanel>
                  <DockPanel>
                    <TextBlock x:Name="SubjectCounter" DockPanel.Dock="Right" VerticalAlignment="Center" Width="40"
                               TextAlignment="Right" Opacity="0.7"
                               ToolTip.Tip="Keep the summary under 50 characters, 72 at most" />
                    <Button x:Name="WriteMessageButton" DockPanel.Dock="Right" Content="Write" Margin="6,0,0,0"
                            IsVisible="False" ToolTip.Tip="Write the message from the staged changes with AI" />
                    <Button x:Name="RecentButton" DockPanel.Dock="Right" Content="Recent" Margin="6,0,0,0"
                            ToolTip.Tip="Reuse a recent commit message" />
                    <Button x:Name="TemplateButton" DockPanel.Dock="Right" Content="Template" Margin="6,0,0,0"
                            IsVisible="False" ToolTip.Tip="Show this repository's commit message template" />
                    <TextBox x:Name="SummaryBox" Watermark="Summary (required)" />
                  </DockPanel>
                  <TextBox x:Name="DescriptionBox" Watermark="Description" AcceptsReturn="True" TextWrapping="Wrap"
                           Height="90" />
                  <!-- Co-authors: credited with Co-authored-by lines, shown on GitHub and GitLab -->
                  <ToggleButton x:Name="CoAuthorsToggle" Content="Co-authors" Padding="8,2"
                                ToolTip.Tip="Credit other people on this commit" />
                  <Border x:Name="CoAuthorsPanel" IsVisible="False" BorderBrush="{DynamicResource Urras.Divider}"
                          BorderThickness="1" CornerRadius="4" Padding="6,4">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Left" Text="Co-authors" Opacity="0.7" VerticalAlignment="Center"
                                 Margin="0,0,8,0" />
                      <WrapPanel x:Name="CoAuthorChips" DockPanel.Dock="Left" VerticalAlignment="Center" />
                      <AutoCompleteBox x:Name="CoAuthorBox" FilterMode="Contains" MinimumPrefixLength="1"
                                       Watermark="Name &lt;email&gt; or pick someone, then Enter" />
                    </DockPanel>
                  </Border>
                  <DockPanel>
                    <Button x:Name="CommitButton" DockPanel.Dock="Right" Content="Commit" Classes="accent"
                            ToolTip.Tip="Commit (Ctrl+Enter)" />
                    <CheckBox x:Name="AmendBox" Content="Amend last commit" />
                  </DockPanel>
                </StackPanel>
              </Grid>

              <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

              <DockPanel Grid.Column="2" Margin="6,6,0,4">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                  <ComboBox x:Name="DiffModeBox" DockPanel.Dock="Right" Width="170" ToolTip.Tip="Diff view">
                    <ComboBoxItem>Unified</ComboBoxItem>
                    <ComboBoxItem>Split</ComboBoxItem>
                    <ComboBoxItem>Raw (git output)</ComboBoxItem>
                  </ComboBox>
                  <CheckBox x:Name="WrapBox" DockPanel.Dock="Right" Content="Wrap" Margin="8,0"
                            ToolTip.Tip="Wrap long lines instead of scrolling sideways" />
                  <CheckBox x:Name="PreviewBox" DockPanel.Dock="Right" Content="Preview" Margin="8,0,0,0"
                            IsVisible="False"
                            ToolTip.Tip="Show the file rendered, old and new side by side" />
                  <CheckBox x:Name="WhitespaceBox" DockPanel.Dock="Right" Content="Whitespace"
                            ToolTip.Tip="Show spaces, tabs, trailing whitespace and CRLF or LF line endings" />
                  <ComboBox x:Name="FileModeBox" DockPanel.Dock="Right" Width="130" Margin="0,0,8,0"
                            ToolTip.Tip="Per file: one file at a time. Combined: every file in the list at once">
                    <ComboBoxItem>Per file</ComboBoxItem>
                    <ComboBoxItem>Combined</ComboBoxItem>
                  </ComboBox>
                  <local:DiffStatView x:Name="DiffStats" DockPanel.Dock="Right" />
                  <TextBlock x:Name="DiffTitle" Classes="header" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <Panel>
                  <ListBox x:Name="DiffList" Classes="diff" SelectionMode="Multiple" />
                  <!-- Where the changes are, drawn over the scroll bar; clicks go through to it -->
                  <local:DiffOverview x:Name="DiffMarks" HorizontalAlignment="Right" Width="6" Margin="0,0,3,0"
                                      IsHitTestVisible="False" IsVisible="{Binding #DiffList.IsVisible}" />
                  <local:ImageDiffView x:Name="ImageView" IsVisible="False" />
                  <local:MarkdownDiffView x:Name="MarkdownView" IsVisible="False" />
                  <TextBlock x:Name="DiffHint" Classes="hint" Text="Select a file to see its changes" />
                </Panel>
              </DockPanel>
            </Grid>
          </DockPanel>
        </TabItem>

        <TabItem Header="History">
          <Grid RowDefinitions="Auto,Auto,*,4,2*">
            <!-- Search: Enter to search, Clear to show the whole history again -->
            <DockPanel Grid.Row="0" Margin="0,6,0,0">
              <ComboBox x:Name="SearchModeBox" DockPanel.Dock="Left" Width="150" Margin="0,0,6,0">
                <ComboBoxItem>Message</ComboBoxItem>
                <ComboBoxItem>Author</ComboBoxItem>
                <ComboBoxItem>File or folder</ComboBoxItem>
                <ComboBoxItem>Content</ComboBoxItem>
              </ComboBox>
              <CheckBox x:Name="AllBranchesBox" DockPanel.Dock="Right" Content="All branches" Margin="8,0,0,0"
                        ToolTip.Tip="Every branch, remote branch and tag, not only the current branch" />
              <Button x:Name="ClearSearchButton" DockPanel.Dock="Right" Content="Clear" Margin="6,0,0,0" />
              <TextBlock x:Name="HistoryFilterText" DockPanel.Dock="Right" VerticalAlignment="Center" Opacity="0.7"
                         Margin="8,0,0,0" MaxWidth="420" TextTrimming="CharacterEllipsis" />
              <TextBox x:Name="SearchBox" Watermark="Search the history, then press Enter"
                       Classes="clearButton" />
            </DockPanel>
            <!-- Column titles; the padding matches the list items below so the columns line up -->
            <Border Grid.Row="1" Margin="0,6,0,0" Padding="8,4" Background="{DynamicResource Urras.Raised}"
                    CornerRadius="6">
              <Grid ColumnDefinitions="*,170,80,150">
                <TextBlock Grid.Column="0" Classes="columnHeader" Text="Graph and summary" />
                <TextBlock Grid.Column="1" Classes="columnHeader" Text="Username" Margin="8,0,0,0" />
                <TextBlock Grid.Column="2" Classes="columnHeader" Text="Commit" Margin="8,0,0,0" />
                <TextBlock Grid.Column="3" Classes="columnHeader" Text="YYYY-MM-DD HH:MM" Margin="8,0,0,0" />
              </Grid>
            </Border>
            <TextBlock x:Name="HistoryHint" Grid.Row="2" Classes="hint" Text="No commits yet" ZIndex="1" />
            <!-- History loads 300 commits at a time; this loads 300 more -->
            <Button x:Name="ShowMoreHistoryButton" Grid.Row="2" ZIndex="1" Content="Show more history"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" IsVisible="False" />
            <ListBox x:Name="HistoryList" Grid.Row="2" Classes="history" Margin="0,0,0,6" SelectionMode="Multiple"
                     ToolTip.Tip="Select two commits (Ctrl+click) to compare them">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,170,80,150" Height="28">
                    <DockPanel Grid.Column="0">
                      <!-- The graph, with the author's picture inside each commit's ring -->
                      <Panel DockPanel.Dock="Left" Margin="0,0,4,0">
                        <local:GraphView Row="{Binding Graph}" />
                        <local:AvatarView Email="{Binding Email}" PersonName="{Binding Author}"
                                          IsVisible="{Binding Graph, Converter={x:Static ObjectConverters.IsNotNull}}"
                                          Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Margin="{Binding Graph,
                                                   Converter={x:Static local:GraphConverters.AvatarMargin}}"
                                          IsHitTestVisible="False" />
                      </Panel>
                      <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding RefBadges}"
                                    IsVisible="{Binding HasRefs}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Classes="refBadge" Classes.head="{Binding IsHead}"
                                    Classes.remote="{Binding IsRemote}" Classes.tag="{Binding IsTag}"
                                    Classes.stash="{Binding IsStash}" Classes.lane="{Binding IsBranch}">
                              <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="{Binding Text}" />
                                <!-- The remote branch is on the same commit -->
                                <TextBlock Classes="remoteName" Text="{Binding Remote}" IsVisible="{Binding HasRemote}"
                                           ToolTip.Tip="The remote's branch of the same name is here too" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <!-- Like GitHub Desktop, each commit a push would send is marked; an arrow when narrow.
                           Inside the summary's panel, so the summary trims to make room for it -->
                      <Border DockPanel.Dock="Right" Classes="unpushed" IsVisible="{Binding IsUnpushed}"
                              ToolTip.Tip="{Binding UnpushedTip}">
                        <Panel>
                          <TextBlock Classes="wide" Text="{Binding UnpushedText}" />
                          <TextBlock Classes="narrow" Text="↑" />
                        </Panel>
                      </Border>
                      <local:CommitSubjectBlock Parts="{Binding SubjectParts}" TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Grid.Column="1" Margin="8,0,0,0">
                      <local:AvatarView DockPanel.Dock="Left" Email="{Binding Email}" PersonName="{Binding Author}"
                                        Margin="0,0,6,0" VerticalAlignment="Center" Tag="author" Classes="link" />
                      <TextBlock Text="{Binding Author}" TextTrimming="CharacterEllipsis" Opacity="0.7"
                                 VerticalAlignment="Center" Tag="author" Classes="link"
                                 ToolTip.Tip="Open their profile, or this commit when the profile isn't known" />
                    </DockPanel>
                    <TextBlock Grid.Column="2" Text="{Binding ShortHash}" Classes="mono link" Opacity="0.7"
                               Margin="8,0,0,0" VerticalAlignment="Center" Tag="commit"
                               ToolTip.Tip="Open this commit on the website" />
                    <TextBlock Grid.Column="3" Text="{Binding DateText}" Opacity="0.7" Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <GridSplitter Grid.Row="3" ResizeDirection="Rows" />
            <DockPanel Grid.Row="4" Margin="0,6,0,4">
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <ComboBox x:Name="CommitDiffModeBox" DockPanel.Dock="Right" Width="170" ToolTip.Tip="Diff view">
                  <ComboBoxItem>Unified</ComboBoxItem>
                  <ComboBoxItem>Split</ComboBoxItem>
                  <ComboBoxItem>Raw (git output)</ComboBoxItem>
                </ComboBox>
                <CheckBox x:Name="CommitWrapBox" DockPanel.Dock="Right" Content="Wrap" Margin="8,0"
                          ToolTip.Tip="Wrap long lines instead of scrolling sideways" />
                <CheckBox x:Name="CommitPreviewBox" DockPanel.Dock="Right" Content="Preview" Margin="8,0,0,0"
                          IsVisible="False"
                          ToolTip.Tip="Show the file rendered, old and new side by side" />
                <CheckBox x:Name="CommitWhitespaceBox" DockPanel.Dock="Right" Content="Whitespace"
                          ToolTip.Tip="Show spaces, tabs, trailing whitespace and CRLF or LF line endings" />
                <ComboBox x:Name="CommitFileModeBox" DockPanel.Dock="Right" Width="130" Margin="0,0,8,0"
                          ToolTip.Tip="Per file: a list of changed files. Combined: the whole commit in one diff">
                  <ComboBoxItem>Per file</ComboBoxItem>
                  <ComboBoxItem>Combined</ComboBoxItem>
                </ComboBox>
                <local:DiffStatView x:Name="CommitDiffStats" DockPanel.Dock="Right" />
                <TextBlock x:Name="CommitDiffTitle" Classes="header" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <ListBox x:Name="CommitFilesList" DockPanel.Dock="Left" Width="280" Margin="0,0,6,0" Classes="files">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <local:ChangeKindBadge Change="{Binding}" />
                      <TextBlock Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Panel>
                <ListBox x:Name="CommitDiffList" Classes="diff" />
                <local:DiffOverview x:Name="CommitDiffMarks" HorizontalAlignment="Right" Width="6" Margin="0,0,3,0"
                                    IsHitTestVisible="False" IsVisible="{Binding #CommitDiffList.IsVisible}" />
                <local:ImageDiffView x:Name="CommitImageView" IsVisible="False" />
                <local:MarkdownDiffView x:Name="CommitMarkdownView" IsVisible="False" />
                <TextBlock x:Name="CommitDiffHint" Classes="hint" Text="Select a commit to see its changes" />
              </Panel>
            </DockPanel>
          </Grid>
        </TabItem>

      </TabControl>
      </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
