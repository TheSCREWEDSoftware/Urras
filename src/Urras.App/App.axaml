<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Urras.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <!-- Every window and dialog carries the Urras icon -->
    <Style Selector=":is(Window)">
      <Setter Property="Icon" Value="/Assets/urras.ico" />
    </Style>
  </Application.Styles>
</Application>
